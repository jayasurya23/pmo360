# =============================================================================
# PMO 360 — PRODUCTION environment template.
#
# Copy the values into your host's secret store (Azure Container Apps secrets
# / App Service application settings / Key Vault references). Do NOT commit a
# filled-in copy — .env files are gitignored for a reason.
#
# Anything marked (secret) belongs in a secret, not plain config.
# =============================================================================

# ---- Mode ----
LOCAL_DEV_MODE=false              # false → Postgres + SharePoint paths active

# ---- Database (Azure Database for PostgreSQL Flexible Server) ----
# (secret) full SQLAlchemy URL. sslmode=require for Azure Postgres.
DATABASE_URL=postgresql://pmo:CHANGEME@pmo360-db.postgres.database.azure.com:5432/pmo360?sslmode=require

# ---- OpenAI ----
OPENAI_API_KEY=                   # (secret)
OPENAI_MODEL=gpt-5.4-mini

# ---- Microsoft Entra (auth) ----
AUTH_REQUIRED=true                # enforce sign-in on every route in prod
AZURE_TENANT_ID=551da9d2-5fa9-40e4-a8a4-4845c4b6376a
AZURE_CLIENT_ID=                  # the prod app registration's client id
AZURE_CLIENT_SECRET=              # (secret) used for app-only SharePoint upload
ADMIN_EMAILS=jbhaskar@castillope.com

# ---- SharePoint storage (Microsoft Graph, app-only) ----
# Fill SITE_ID + DRIVE_ID via:  python scripts/sharepoint_ids.py <site-url>
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_ROOT_FOLDER=PMO 360

# ---- CORS ----
# Single-origin deploy serves the SPA + API from the same host, so CORS is
# mostly moot — but list the prod origin anyway for any cross-origin tools.
CORS_ORIGINS=https://pmo360.example.azurecontainerapps.io

# ---- App chrome ----
APP_TITLE=PMO 360
APP_TAGLINE=Castillo Engineering Project Management Office
TOOL_NAME=Meeting Minutes
DEFAULT_TIMEZONE=America/New_York

# ---- Server ----
PORT=8000
UVICORN_WORKERS=2
PMO360_STATIC_DIR=/app/static     # where the Docker image bakes the built SPA
