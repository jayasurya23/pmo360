# Production build config for the SPA — read by `vite build`.
# These are PUBLIC values (inlined into the shipped JS bundle, not secrets):
#   - tenant/client id are identifiers anyone can read in the browser
#   - the redirect URI is intentionally omitted; MSAL resolves it at runtime
#     from window.location.origin, so the same build works on any host.
# The backend serves the SPA same-origin, so the API base is just /api.
VITE_API_BASE=/api
VITE_AZURE_TENANT_ID=551da9d2-5fa9-40e4-a8a4-4845c4b6376a
VITE_AZURE_CLIENT_ID=5c274f14-d34d-4cb2-960c-51efbd76a6fb
