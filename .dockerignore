# Keep the build context small + avoid leaking local state into the image.
**/node_modules
**/dist
**/.venv
**/venv
**/__pycache__
**/*.pyc
backend/data
backend/.env
backend/.env.*
# Exclude the LOCAL frontend env, but KEEP .env.production — it carries the
# public build config (tenant/client id) the production SPA build needs.
frontend/.env
frontend/.env.local
.git
.github
**/.DS_Store
*.md
docs
.claude
