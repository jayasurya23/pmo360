# Top-level Compose env. Optional — defaults work for local docker compose.
# Copy to .env and tweak if needed.

POSTGRES_USER=pmo
POSTGRES_PASSWORD=changeme-in-production
POSTGRES_DB=pmo360

# Number of Uvicorn worker processes (scale with CPU cores)
UVICORN_WORKERS=4

# Host port the frontend nginx listens on (80 = default web port)
FRONTEND_PORT=80
