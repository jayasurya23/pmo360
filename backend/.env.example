# Copy to .env and fill in real values.

LOCAL_DEV_MODE=true

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Local dev paths (relative to backend/) ---
SQLITE_PATH=data/castillo.db
LOCAL_OUTPUT_DIR=data/outputs

# --- Production database ---
DATABASE_URL=postgresql://pmo:pmo@db:5432/pmo360

# --- Microsoft Graph / SharePoint (production storage) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_ROOT_FOLDER=Castillo Meeting Tool

# --- Email ---
SEND_FROM_EMAIL=pmo@castilloengineering.com

# --- App ---
APP_TITLE=PMO 360
APP_TAGLINE=Castillo Engineering Project Management Office
TOOL_NAME=Meeting Minutes
APP_PORT=8000
DEFAULT_TIMEZONE=America/New_York

# --- CORS — comma-separated allowed origins ---
CORS_ORIGINS=http://localhost:5173,https://your-domain.example.com
